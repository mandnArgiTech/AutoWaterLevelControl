# FLM Platform — default configuration (copied to .env on first install)
# Full documentation for EVERY setting below:
#   server/README.md → "Configuration reference (config/defaults.env)"
# Edit live values via: ./flm-server.sh → Configure  (writes server/.env)

# ── MQTT broker (Mosquitto) ──────────────────────────────────────────────────
MQTT_SERVER_CN=vivasvan-tech.in
MQTT_SAN_DNS=vivasvan-tech.in,localhost
MQTT_SAN_IPS=31.97.235.233,127.0.0.1

MQTT_USER_BRIDGE=flmServerAdmin
MQTT_PASS_BRIDGE=flmPass
MQTT_USER_DEVICE=devAdmin
MQTT_PASS_DEVICE=123456
MQTT_USER_VENDOR=vendor_demo
MQTT_PASS_VENDOR=vendor_demo_secret

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
POSTGRES_DB=flmDB
POSTGRES_USER=flmAdmin
POSTGRES_PASSWORD=flmPass
POSTGRES_PORT=5432

# ── Java API (backend) ───────────────────────────────────────────────────────
API_PORT=8080
# Min 32 characters — change before production (signs web login JWTs)
FLM_JWT_SECRET=change-me-in-production-use-256-bit-secret-key-here-min32chars
# CORS allowlist for browser → API (comma-separated)
FLM_WEB_ALLOWED_ORIGINS=https://vivasvan-tech.in,http://vivasvan-tech.in,http://localhost:3000,http://localhost:5173

# ── MQTT Dynamic Security (platform admin control API) ───────────────────────
# Used by backend MqttControlService ($CONTROL/dynamic-security/v1)
# Must match mosquitto/config/dynamic-security.json admin client
MQTT_DYNSEC_ADMIN=flmDynsecAdmin
MQTT_DYNSEC_PASS=flmDynsecPass

# ── React UI (frontend) ──────────────────────────────────────────────────────
FRONTEND_PORT=3000
FRONTEND_DEV_PORT=5173
VITE_API_BASE=/api

# ── Deployment mode (docker | standalone) ────────────────────────────────────
FLM_DEPLOY_MODE=standalone
