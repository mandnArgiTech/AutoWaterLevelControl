# FLM Platform — default configuration (copied to .env on first install)
# Full documentation for EVERY setting below:
#   server/README.md → "Configuration reference (config/defaults.env)"
# Edit live values via: ./flm-server.sh → Configure  (writes server/.env)

# ── MQTT broker (Mosquitto) ──────────────────────────────────────────────────
MQTT_SERVER_CN=vivasvan-tech.in
MQTT_SAN_DNS=vivasvan-tech.in,localhost
MQTT_SAN_IPS=31.97.235.233,127.0.0.1

MQTT_USER_BRIDGE=flmServerAdmin
MQTT_PASS_BRIDGE=flmPass
MQTT_USER_DEVICE=devAdmin
MQTT_PASS_DEVICE=123456

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
POSTGRES_DB=flmDB
POSTGRES_USER=flmAdmin
POSTGRES_PASSWORD=flmPass
POSTGRES_PORT=5432

# ── Java API (backend) ───────────────────────────────────────────────────────
API_PORT=8080
FLM_JWT_SECRET=change-me-in-production-use-256-bit-secret-key-here

# ── React UI (frontend) ──────────────────────────────────────────────────────
FRONTEND_PORT=3000
FRONTEND_DEV_PORT=5173
VITE_API_BASE=/api

# ── Deployment mode (docker | standalone) ────────────────────────────────────
FLM_DEPLOY_MODE=standalone
