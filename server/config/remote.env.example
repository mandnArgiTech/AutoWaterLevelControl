# Remote VPS deployment — copy to remote.env and fill in (NEVER commit remote.env)
#
#   cp config/remote.env.example config/remote.env
#   chmod 600 config/remote.env
#
# Or use menu: ./flm-server.sh → Remote VPS → Configure

FLM_REMOTE_HOST=vivasvan-tech.in
FLM_REMOTE_USER=root
FLM_REMOTE_PASSWORD=
FLM_REMOTE_PATH=/opt/flm
FLM_REMOTE_PORT=22
# standalone (default production) | docker
FLM_REMOTE_INSTALL_MODE=standalone
