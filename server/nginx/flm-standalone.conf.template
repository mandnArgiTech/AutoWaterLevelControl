# Generated by flm-server.sh — do not edit by hand (use Configure → Frontend)
# Paths are absolute (system nginx resolves relative paths against /usr/share/nginx, not /opt/flm)
pid __NGINX_PID__;
error_log __NGINX_ERROR_LOG__ warn;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    keepalive_timeout 65;

    # Avoid stale HTML after deploys (browser would keep an old index → old JS)
    map $sent_http_content_type $cache_control_html {
        default                 "";
        ~*text/html             "no-cache, no-store, must-revalidate, max-age=0";
    }

    server {
        listen __FRONTEND_PORT__;
        server_name _;
        root __FRONTEND_ROOT__;
        index index.html;

        location /api/ {
            proxy_pass http://127.0.0.1:__API_PORT__/api/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_no_cache 1;
            proxy_cache_bypass 1;
            add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        }

        # Fingerprinted Vite bundles — safe to cache forever
        location /assets/ {
            add_header Cache-Control "public, max-age=31536000, immutable";
            try_files $uri =404;
        }

        location = /index.html {
            add_header Cache-Control "no-cache, no-store, must-revalidate, max-age=0" always;
            add_header Pragma "no-cache" always;
            add_header Expires "0" always;
            etag off;
            if_modified_since off;
        }

        location / {
            add_header Cache-Control $cache_control_html always;
            try_files $uri $uri/ /index.html;
        }
    }
}
